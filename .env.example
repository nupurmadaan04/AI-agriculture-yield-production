# =============================================================================
# Agricultural Decision Intelligence Platform — Environment Configuration Template
# Copy this file to .env and adjust parameters as needed. Never commit .env with secrets.
# =============================================================================

# Application Environment (development, testing, production)
APP_ENV=production
DEBUG=false

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Allowed Origins (comma-separated list of allowed web origins)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:5173

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Directory Overrides (Optional — defaults to relative project paths)
MODEL_ROOT=Models
DATA_ROOT=Datasets
REPORTS_DIR=reports

# In-Memory Cache Configuration
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# Frontend Build Variables (Used during frontend build/containerization)
VITE_API_BASE_URL=/api

# Optional External GenAI LLM Integration (Leaves empty for deterministic rule synthesis)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
